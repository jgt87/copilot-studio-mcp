# Copy to the project root as .editorconfig (docs/12-line-endings.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cmd,bat,sln}]
end_of_line = crlf

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
