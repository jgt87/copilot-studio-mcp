{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "server", "out"]
}
